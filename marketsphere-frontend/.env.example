# MarketSphere FRONTEND configuration. Copy to .env.local if you need to change anything.

# Where the backend runs (used ONLY by the Vite dev/preview proxy).
VITE_DEV_PROXY_TARGET=http://localhost:4000

# API base used by the browser. Leave as /api/v1 (same origin via proxy) unless the backend is on
# another domain, e.g. https://api.example.com/api/v1 (then add this site to the backend's CORS_ORIGINS).
VITE_API_BASE=/api/v1
