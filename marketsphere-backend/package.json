{
  "name": "marketsphere-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MarketSphere Multi-Vendor Marketplace Enterprise REST API",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
