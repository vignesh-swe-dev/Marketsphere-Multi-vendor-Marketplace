# MarketSphere API settings. Copy this file to ".env" (cp .env.example .env) and edit.

PORT=4000
NODE_ENV=development

# Browser addresses allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# DATABASE: choose ONE way
#
# A) LOCAL (default for development). Leave MONGODB_URI empty / commented out.
#    The API starts a real MongoDB on your PC and keeps data in backend/data/mongo.
#    It uses a "mongod" program that is already installed, or downloads one the first time (about 200 MB).
#    Demo data (shops, products, accounts) is loaded automatically on first start.
#
# B) MONGODB / ATLAS. Remove the # and paste your connection string:
#      MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/marketsphere?retryWrites=true&w=majority
#    or a MongoDB on your own computer / server:
#      MONGODB_URI=mongodb://127.0.0.1:27017/marketsphere?replicaSet=rs0
#    (Checkout uses transactions, so MongoDB must run as a replica set. Atlas always does.)
# ---------------------------------------------------------------------------
# MONGODB_URI=

# Local mode only (optional)
# LOCAL_MONGO_PORT=27018
# LOCAL_DB_DIR=./data/mongo
# MONGOD_PATH=C:\Program Files\MongoDB\Server\8.0\bin\mongod.exe

# ---------------------------------------------------------------------------
# PRODUCTION (NODE_ENV=production) needs:
#   MONGODB_URI            required
#   JWT_ACCESS_SECRET      required, at least 32 random characters:
#                          node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   PAYMENT_WEBHOOK_SECRET set your own value
# Demo data is NOT created in production. Create the first admin with:
#   npm run create-admin -- you@company.com "Your Name"
# ---------------------------------------------------------------------------
# JWT_ACCESS_SECRET=
# PAYMENT_WEBHOOK_SECRET=
# TRUST_PROXY=1

# Demo accounts password and demo data switches (development)
# DEMO_PASSWORD=Demo@12345
# SEED_DEMO_DATA=true

# The built-in payment provider is a SANDBOX (no real money moves). In production, checkout payment
# is switched off until a real gateway is connected. Set this to true ONLY for a demo/testing server.
# ALLOW_SANDBOX_PAYMENTS=true

# Shop settings
CURRENCY=INR
GST_RATE_PERCENT=18
FLAT_SHIPPING_PAISE=4900
FREE_SHIPPING_THRESHOLD_PAISE=99900
